{
  "name": "pi-session-model",
  "version": "0.1.1",
  "description": "A pi extension package that adds /session-model for per-session model and thinking-level switching.",
  "type": "module",
  "license": "MIT",
  "author": "Milan Glacier",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "model-switcher",
    "coding-agent"
  ],
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
